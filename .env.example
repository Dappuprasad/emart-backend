# Copy this file to ".env" and fill in real values.
# (The real .env is git-ignored so secrets are never committed.)

# Port the server listens on. Hosts like Render set this automatically.
PORT=4000

# Allowed frontend origin(s) for CORS. Comma-separated for multiple.
# In production, set this to your live site, e.g. https://emart.vercel.app
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string (from Neon).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret
